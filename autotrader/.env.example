# Copy to .env and fill in. NEVER commit .env. Keys are read from the environment only.

# --- Claude (AI decision engine) ---
ANTHROPIC_API_KEY=

# --- Alpaca PAPER credentials (used when trading.mode = paper) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# --- Alpaca LIVE credentials (only read when trading.mode = live AND live is authorized) ---
# Leave empty unless you have deliberately completed the live-authorization step.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# --- Dashboard: token required for the emergency-stop and other write endpoints ---
DASHBOARD_TOKEN=change-me-to-a-long-random-string

# Optional overrides
# AUTOTRADER_CONFIG=config/default.yaml
# AUTOTRADER_MODE=paper
